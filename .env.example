# ==========================================
# LECTURE POD ENVIRONMENT CONFIGURATION
# ==========================================

# Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Security
# Generates secure cookie sessions for local auth or seamlessly connects to Supabase
SESSION_SECRET=lecturepod_dev_secret_key_minimum_32_characters_for_security_12345

# Database Mode: "sqlite" (instant zero-config local file) or "supabase" (cloud PostgreSQL)
DATABASE_MODE=sqlite

# Supabase Configuration (Optional - Required only if using Supabase Cloud)
# Get these from your Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Provider: "local" (saves to public/uploads/audio) or "supabase" (Supabase Storage bucket)
STORAGE_PROVIDER=local
SUPABASE_STORAGE_BUCKET=lecture-recordings

# Speech-to-Text Provider: "openai", "groq", "deepgram", or "mock" (fallback when no API key)
SPEECH_TO_TEXT_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# LLM Provider for Notes, Flashcards, Quizzes: "openai", "gemini", "groq", or "template"
LLM_PROVIDER=openai
GEMINI_API_KEY=

# LecturePod Hardware Device Integration
DEVICE_API_SALT=lecturepod_hardware_device_salt_2025
