[Unit]
Description=LecturePod Device Recording & Sync Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/lecturepod-agent
ExecStart=/usr/bin/python3 /home/pi/lecturepod-agent/lecturepod_agent.py daemon
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
